# =============================================================================
# Job Board — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values. The .env file is gitignored.
#
# Note: OPENAI_API_KEY can be set here or via the in-app setup wizard at /setup
# (which writes to this file on save). The wizard is the easier path for new users.

# -----------------------------------------------------------------------------
# Database (required, defaults work out of the box with Docker Compose)
# -----------------------------------------------------------------------------
POSTGRES_USER=jobboard
POSTGRES_PASSWORD=jobboard
POSTGRES_DB=jobboard
DATABASE_URL=postgresql+asyncpg://jobboard:jobboard@db:5432/jobboard

# -----------------------------------------------------------------------------
# Redis (required, defaults work with Docker Compose)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# SearXNG (self-hosted web search, runs as a Docker Compose service)
# -----------------------------------------------------------------------------
SEARXNG_URL=http://searxng:8080

# -----------------------------------------------------------------------------
# LLM provider (pick one — drives all AI features)
# -----------------------------------------------------------------------------
# Mirror is provider-agnostic. Anthropic and Ollama are accessed via their
# OpenAI-compatible endpoints, so the same SDK works across all three.
#
#   openai     OPENAI_API_KEY required
#   anthropic  ANTHROPIC_API_KEY required (uses Anthropic's OpenAI-compat shim)
#   ollama     no key — set OLLAMA_BASE_URL if not the default
#
# OpenAI is the most-tested path. Anthropic and Ollama work for the common
# case (chat with system + user messages); a few callsites use OpenAI-only
# features (e.g. ``reasoning_effort``) which other providers silently ignore.
LLM_PROVIDER=openai

# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ollama — local self-hosted models (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1

# -----------------------------------------------------------------------------
# Per-role model overrides (optional)
# -----------------------------------------------------------------------------
# Leave blank to use sensible defaults baked into backend/app/ai/client.py for
# each provider. Override here if you want to pin a specific model.
#
#   resume      heavy lift — full resume generation, revisions, agent edits
#   scoring     mid — scoring, planning, dedup
#   extraction  light — extraction, parsing, classification
LLM_RESUME_MODEL=
LLM_SCORING_MODEL=
LLM_EXTRACTION_MODEL=

# -----------------------------------------------------------------------------
# Profile configuration (optional)
# -----------------------------------------------------------------------------
# Path to your profile YAML inside the container. If the file doesn't exist,
# the app will prompt you to upload a resume at /onboarding instead.
PROFILE_YAML_PATH=/app/docs/profile.yaml

# -----------------------------------------------------------------------------
# Logging (optional)
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO
