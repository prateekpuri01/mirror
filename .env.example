# PostgreSQL
POSTGRES_USER=jobboard
POSTGRES_PASSWORD=jobboard
POSTGRES_DB=jobboard

# Database URL (used by FastAPI + Alembic)
DATABASE_URL=postgresql+asyncpg://jobboard:jobboard@db:5432/jobboard

# NocoDB — connects to the same Postgres instance
NC_DB=pg://db:5432?u=jobboard&p=jobboard&d=jobboard

# Redis (scheduler / cache)
REDIS_URL=redis://redis:6379/0

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Profile YAML path (inside container)
PROFILE_YAML_PATH=/app/docs/profile.yaml
