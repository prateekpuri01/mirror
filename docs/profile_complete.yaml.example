awards:

  - id: award-helio-distinguished-2024
    employer: Helio Labs
    name: Distinguished Engineer Award
    year: 2024
    impact_summary: |
      Annual award recognizing technical contribution that shaped the company
      stack. Cited the eval harness adoption.

  - id: award-brightline-innovation-2021
    employer: Brightline Health
    name: Innovation Prize
    year: 2021
    impact_summary: |
      Awarded for the patient-message triage rollout — the first production
      ML deployment at the company.

  - id: award-berkeley-citation-2016
    employer: UC Berkeley
    name: CS Departmental Citation (highest honors)
    year: 2016
    impact_summary: |
      Departmental honor recognizing top-of-class undergraduate performance
      in Computer Science.
