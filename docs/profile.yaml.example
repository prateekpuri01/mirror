# User Profile — source of truth for job matching, resume tailoring, and UI display
#
# Quick start:
#   1. Copy this file to docs/profile.yaml and edit with your real data, OR
#   2. Skip this file and use the in-app onboarding wizard
#      (upload your resume at /onboarding) to auto-generate your profile.
#
# The app reads docs/profile.yaml at startup. The data here is fictional and
# illustrative — replace with your own. Long-form accomplishments belong in
# docs/profile_complete.yaml (see profile_complete.yaml.example).

personal:
  name: Sam Rivera
  email: sam.rivera@example.com
  phone: "415-555-0123"
  linkedin: linkedin.com/in/sam-rivera-example
  google_scholar: ""              # optional — leave blank if not academic
  location: San Francisco, CA
  willing_to_relocate: false
  remote_preference: remote        # remote | hybrid | onsite | flexible
  professional_links: []
    # - label: Personal site
    #   url: https://samrivera.example.com
    # - label: GitHub
    #   url: https://github.com/sam-rivera-example

target_roles:
