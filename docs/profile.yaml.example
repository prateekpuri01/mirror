search_preferences:
  salary_minimum: 220000
  industries_ranked:
    - frontier-model AI labs
    - research-first AI startups
    - applied ML at established tech
    - regulated-domain AI (health, finance)
  company_size: any        # startup | mid | large | any
  deal_breakers:
    - ad-tech
    - surveillance products
  nice_to_haves:
    - publishes research or open-source
    - small but senior team
    - remote-first
  org_anti_patterns:
    - title-heavy bureaucracies
    - opaque promotion processes
