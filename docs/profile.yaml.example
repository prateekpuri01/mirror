work_history:
  - employer: Helio Labs
    title: Senior Applied AI Scientist
    start: "2022-06"
    end: null              # null = current position
    location: San Francisco, CA
  - employer: Brightline Health
    title: ML Engineer
    start: "2020-04"
    end: "2022-05"
    location: Remote
  - employer: Marlin Systems
