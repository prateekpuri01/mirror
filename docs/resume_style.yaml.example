# Resume DOCX styling configuration
#
# Copy to resume_style.yaml and customize. If this file doesn't exist, the
# app uses these defaults — the "Mustard" theme: clean editorial single-
# column with a saturated mustard accent on rules and the tagline.

colors:
  navy: "#1A1A1A"        # Name (bold) + section headers (near-black)
  orange: "#B8851E"      # Mustard accent — tagline + rules + emphasis
  contact: "#555555"     # Contact line
  separator: "#B8B8B8"   # Separator characters between contact items
  dark: "#1F1F1F"        # Body text (near-black)
  name_first: "#8B7355"  # First name (warm tan, echoes the accent)
  link: "#8B6914"        # Hyperlinks (darker mustard, readable on white)
  border: "#B8851E"      # Section-header underline — this is the visual pop

fonts:
  # Serif name + sans body for editorial contrast. Cambria ships with
  # Office; Word substitutes Georgia or Times if absent. Aptos is the
  # modern Microsoft default sans (Calibri / Helvetica are fallbacks).
  name_light: "Cambria"
  name_bold: "Cambria"
  body: "Aptos"
  skill_label: "Aptos"

sizes:
  name: 30           # Name font size (pt)
  tagline: 10.5      # Tagline beneath the name
  contact: 9         # Contact info line
  section_header: 12
  body: 10
  body_small: 9.5

margins:
  top: 0.6           # inches
  bottom: 0.6
  left: 0.7
  right: 0.7

# --- Alternative palettes to try ---------------------------------------------
# Drop one of these into the colors: block above for a different mood.
#
# "Slate" (cool monochrome, muted teal accent):
#   navy: "#1E293B"        orange: "#0E7C7B"      contact: "#475569"
#   separator: "#94A3B8"   dark: "#0F172A"        name_first: "#64748B"
#   link: "#0E7C7B"        border: "#0E7C7B"
